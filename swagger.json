  "info": {
    "title": "PCSO Lotto API",
    "description": "API for retrieving PCSO lotto draws, syncing results, and analyzing historical statistics.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cron-token": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ApiResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "number",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "Success"
          },
          "action_at": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "description": "Endpoint-specific response payload.",
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            ]
          }
        },
        "required": [
          "status",
          "message",
          "action_at",
          "data"
        ]
      }
    }
  }
}
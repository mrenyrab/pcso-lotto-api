{
  "openapi": "3.0.0",
  "paths": {
    "/lotto/draw-date/{date}": {
      "get": {
        "operationId": "LottoController_getDraw",
        "parameters": [
          {
            "name": "date",
            "required": true,
            "in": "path",
            "description": "Draw date in YYYY-MM-DD format",
            "schema": {
              "example": "2026-11-19",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Draws for the requested date, including winner counts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseDto"
                }
              }
            }
          }
        },
        "summary": "Get lotto draws for a date",
        "tags": [
          "Lotto"
        ]
      }
    },
    "/lotto/draws/{game}": {
      "get": {
        "operationId": "LottoController_getDrawsForRange",
        "parameters": [
          {
            "name": "game",
            "required": true,
            "in": "path",
            "description": "URL-encode the slash in the game value, for example 6%2F58.",
            "schema": {
              "enum": [
                "6/42",
                "6/45",
                "6/49",
                "6/55",
                "6/58"
              ],
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": true,
            "in": "query",
            "schema": {
              "format": "date",
              "example": "2026-11-19",
              "type": "string"
            }
          },
          {
            "name": "from",
            "required": true,
            "in": "query",
            "schema": {
              "format": "date",
              "example": "2026-11-01",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching draws in the inclusive date range, newest first.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Unsupported lotto game, invalid date, or reversed date range."
          }
        },
        "summary": "Get lotto draws for a game and date range",
        "tags": [
          "Lotto"
        ]
      }
    },
    "/scraper/backfill": {
      "post": {
        "operationId": "ScraperController_runBackfill",
        "parameters": [
          {
            "name": "year",
            "required": true,
            "in": "query",
            "description": "Year to backfill; required by the endpoint.",
            "schema": {
              "minimum": 1,
              "example": 2026,
              "type": "number"
            }
          },
          {
            "name": "month",
            "required": false,
            "in": "query",
            "description": "Month to backfill. Requires year.",
            "schema": {
              "enum": [
                "january",
                "february",
                "march",
                "april",
                "may",
                "june",
                "july",
                "august",
                "september",
                "october",
                "november",
                "december"
              ],
              "type": "string",
              "example": "january"
            }
          },
          {
            "name": "day",
            "required": false,
            "in": "query",
            "description": "Requires both month and year.",
            "schema": {
              "minimum": 1,
              "maximum": 31,
              "example": 19,
              "type": "number"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Backfill completed; returns counts of saved and modified draws.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Missing required date fields or invalid/future date."
          }
        },
        "summary": "Backfill draws by year, month, or day",
        "tags": [
          "Scraper"
        ]
      }
    },
    "/scraper/run": {
      "post": {
        "operationId": "ScraperController_triggerDailySync",
        "parameters": [],
        "responses": {
          "401": {
            "description": "Missing or invalid bearer token."
          },
          "201": {
            "description": "Synchronization completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "cron-token": []
          }
        ],
        "summary": "Trigger a daily PCSO results synchronization",
        "tags": [
          "Scraper"
        ]
      }
    },
